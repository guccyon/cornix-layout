{
  "description": "reorder の files に同じファイルが重なっていれば -32602（field \"edit.files\"）",
  "setup": {
    "profile": "authors_config"
  },
  "request": {
    "id": 1,
    "method": "profile/planItemEdit",
    "params": {
      "profileId": "p1",
      "baseVersions": {
      },
      "edit": {
        "op": "reorder",
        "kind": "combo",
        "files": [
          "combos/00_bracket_pair.yml",
          "combos/00_bracket_pair.yml",
          "combos/01_curly_brace_pair.yml",
          "combos/02_parenthesis_pair.yml",
          "combos/03_quote_pair.yml",
          "combos/04_double_quote_pair.yml",
          "combos/05_codeblock.yml",
          "combos/06_left_click.yml"
        ]
      }
    }
  },
  "response": {
    "id": 1,
    "error": {
      "code": -32602,
      "data": {
        "field": "edit.files"
      }
    }
  }
}
