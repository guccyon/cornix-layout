{
  "description": "バックアップの状態に戻す（戻す前にもバックアップを取る）",
  "setup": {
    "profile": "test_config",
    "allowWrites": true,
    "device": {
      "from": "profile"
    },
    "snapshots": {
      "20261021-101500-pre-apply": {
        "from": "profile",
        "keys": [
          {
            "layer": 0,
            "row": 0,
            "col": 1,
            "value": "KC_A"
          }
        ]
      }
    }
  },
  "request": {
    "id": 1,
    "method": "device/restore",
    "params": {
      "dir": "profiles/default",
      "backup": "20261021-101500-pre-apply",
      "token": "68fbf3809474f4a4"
    }
  },
  "response": {
    "id": 1,
    "result": {
      "applied": 1,
      "remaining": []
    }
  }
}
