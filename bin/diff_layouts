#!/usr/bin/env ruby
# frozen_string_literal: true

# 2 つの layout.vil を 16bit 値（Image::DeviceImage）で比べる。同じ値の別表記（KC_PGDN と KC_PGDOWN など）は同じとみなす。
#
#   ruby bin/diff_layouts                   # tmp/layout.vil と layout.vil
#   ruby bin/diff_layouts file1.vil file2.vil
#
# 同じなら "=== ✓ FILES ARE IDENTICAL ===" で exit 0、違えば違う場所を表示して exit 1
require_relative '../lib/cornix'

if ARGV.size == 2
  file1, file2 = ARGV
elsif ARGV.empty?
  file1 = 'tmp/layout.vil'
  file2 = 'layout.vil'
else
  puts "Usage: #{$PROGRAM_NAME} [FILE1] [FILE2]"
  puts '  Compare two layout.vil files'
  puts ''
  puts 'Examples:'
  puts "  #{$PROGRAM_NAME}                           # Compare tmp/layout.vil and layout.vil (default)"
  puts "  #{$PROGRAM_NAME} file1.vil file2.vil       # Compare two specific files"
  exit 1
end

[file1, file2].each do |file|
  next if File.exist?(file)

  puts "Error: File not found: #{file}"
  exit 1
end

env = Cornix::Application::Environment.new
begin
  orig = env.vil_file.read(file1)
  comp = env.vil_file.read(file2)
rescue Cornix::Error => e
  puts "Error: #{e.message}"
  exit 1
end

vial = env.vial
fmt = ->(code) { code.nil? ? -1 : vial.format_code(code) }
mark = ->(same) { same ? '✓' : '✗ DIFFER' }
setting_label = lambda do |qsid|
  definition = env.settings_catalog.fetch(qsid)
  "#{definition.group}.#{definition.name} (#{qsid})"
rescue StandardError
  qsid.to_s
end
keys = ->(image) { (image.meta.keys + Cornix::Storage::VilFile::SECTIONS).sort.join(', ') }

puts '=== Comparing layout.vil files ==='
puts "  File 1: #{file1}"
puts "  File 2: #{file2}"
puts
puts "Keys in original: #{keys.(orig)}"
puts "Keys in compiled: #{keys.(comp)}"
puts
puts "Version: #{mark.(orig.meta['version'] == comp.meta['version'])}"
puts "UID: #{mark.(orig.meta['uid'] == comp.meta['uid'])}"
puts "Vial protocol: #{mark.(orig.meta['vial_protocol'] == comp.meta['vial_protocol'])}"
puts "Via protocol: #{mark.(orig.meta['via_protocol'] == comp.meta['via_protocol'])}"
puts

layout_match = orig.layers == comp.layers
puts 'Layout structure:'
puts "  Original layers: #{orig.layers.size}"
puts "  Compiled layers: #{comp.layers.size}"
puts "  Match: #{mark.(layout_match)}"
puts

encoder_match = orig.encoders == comp.encoders
puts 'Encoder layout:'
puts "  Match: #{mark.(encoder_match)}"
puts

macro_match = orig.macros == comp.macros
puts 'Macros:'
puts "  Original non-empty: #{orig.macros.count { |m| !m.empty? }}"
puts "  Compiled non-empty: #{comp.macros.count { |m| !m.empty? }}"
puts "  Match: #{mark.(macro_match)}"
puts

td_match = orig.tap_dances == comp.tap_dances
puts 'Tap Dance:'
puts "  Match: #{mark.(td_match)}"
puts

combo_match = orig.combos == comp.combos
puts 'Combos:'
puts "  Match: #{mark.(combo_match)}"
puts

# キーの順も比べる（Hash#== は順を見ない）
settings_match = orig.settings.to_a == comp.settings.to_a
puts 'Settings:'
puts "  Match: #{mark.(settings_match)}"
puts

if orig == comp && settings_match
  puts '=== ✓ FILES ARE IDENTICAL ==='
  exit 0
end

puts '=== ✗ FILES DIFFER ==='
puts

unless layout_match
  puts 'Layout differences:'
  [orig.layers.size, comp.layers.size].max.times do |idx|
    a = orig.layers[idx] || []
    b = comp.layers[idx] || []
    next if a == b

    puts "  Layer #{idx} differs"
    [a.size, b.size].max.times do |row|
      next if a[row] == b[row]

      puts "    Row #{row}: #{a[row]&.map(&fmt).inspect}"
      puts "       vs: #{b[row]&.map(&fmt).inspect}"
    end
  end
  puts
end

unless encoder_match
  puts 'Encoder layout differences:'
  orig.encoders.each_with_index do |layer, li|
    layer.each_with_index do |enc, ei|
      other = comp.encoders.dig(li, ei)
      %i[ccw cw].each_with_index do |dir, ki|
        next if other && enc.public_send(dir) == other.public_send(dir)

        puts "  encoder[#{li}][#{ei}][#{ki}]:"
        puts "    File 1: #{fmt.(enc.public_send(dir)).inspect}"
        puts "    File 2: #{(other && fmt.(other.public_send(dir))).inspect}"
      end
    end
  end
  puts
end

describe_macro = lambda do |macro|
  macro&.map { |a| a.keys.empty? ? [a.kind.to_s, a.value] : [a.kind.to_s, *a.keys.map(&fmt)] }
end
{
  'Macro' => [orig.macros, comp.macros, macro_match, describe_macro],
  'TapDance' => [orig.tap_dances, comp.tap_dances, td_match,
                 ->(td) { td && [td.on_tap, td.on_hold, td.on_double_tap, td.on_tap_hold].map(&fmt) + [td.tapping_term] }],
  'Combo' => [orig.combos, comp.combos, combo_match, ->(c) { c && [*c.keys, c.output].map(&fmt) }]
}.each do |label, (list1, list2, match, describe)|
  next if match

  puts "#{label == 'TapDance' ? 'Tap Dance' : label} differences:"
  [list1.size, list2.size].max.times do |idx|
    next if list1[idx] == list2[idx]

    puts "  #{label} #{idx}:"
    puts "    File 1: #{describe.(list1[idx]).inspect}"
    puts "    File 2: #{describe.(list2[idx]).inspect}"
  end
  puts
end

unless settings_match
  puts 'Settings differences:'
  orig_keys = orig.settings.keys
  comp_keys = comp.settings.keys
  if orig_keys != comp_keys
    puts '  Key order/set differs:'
    puts "    File 1 keys: #{orig_keys.map(&setting_label).inspect}"
    puts "    File 2 keys: #{comp_keys.map(&setting_label).inspect}"
  end
  (orig_keys | comp_keys).each do |k|
    next if orig.settings[k] == comp.settings[k]

    puts "  Setting #{setting_label.(k)}: #{orig.settings[k].inspect} vs #{comp.settings[k].inspect}"
  end
  puts
end

unless orig.meta == comp.meta
  puts 'Other differences:'
  (orig.meta.keys | comp.meta.keys).each do |k|
    next if orig.meta[k] == comp.meta[k]

    puts "  #{k}: #{orig.meta[k].inspect} vs #{comp.meta[k].inspect}"
  end
  puts
end

exit 1
