            "profile": "KC_VOLU",
            "text": "レイヤー0 エンコーダ0 時計回り: KC_NO → KC_VOLU"
          },
          {
            "kind": "tapDance",
            "index": 1,
            "name": "TapDance 1",
            "device": "[SGUI(KC_4), SGUI(KC_5), KC_NO, KC_NO, 180ms]",
            "profile": "[SGUI(KC_4), SGUI(KC_5), KC_NO, KC_NO, 250ms]"
          },
          {
            "kind": "combo",
            "index": 0,
            "name": "Combo 0",
            "device": "[KC_D + KC_F + KC_NO + KC_NO → KC_B]",
            "profile": "[KC_D + KC_F + KC_NO + KC_NO → KC_LBRACKET]"
          },
          {
            "kind": "macro",
            "index": 0,
            "name": "Macro 0",
            "device": "[]",
            "profile": "[[\"tap\",\"KC_LBRACKET\",\"KC_RBRACKET\",\"KC_LEFT\"]]",
            "text": "マクロ M0: [] → [[\"tap\",\"KC_LBRACKET\",\"KC_RBRACKET\",\"KC_LEFT\"]]"
          },
          {
            "kind": "macro",
            "index": 3,
            "name": "Macro 3",
            "device": "[[\"tap\",\"KC_A\"]]"
          },
          {
            "kind": "setting",
            "name": "tapping_term",
            "device": "300",
            "profile": "250",
            "text": "設定 7: 300 → 250"
          }
        ]
