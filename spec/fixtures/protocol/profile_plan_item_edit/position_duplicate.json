  "setup": {
    "profile": "test_config"
  },
  "request": {
    "id": 1,
    "method": "profile/planItemEdit",
    "params": {
      "profileId": "p1",
      "baseVersions": {
      },
      "edit": {
        "op": "renamePosition",
        "hand": "left",
        "row": 0,
