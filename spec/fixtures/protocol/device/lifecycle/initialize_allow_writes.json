{
  "description": "--allow-writes で起動したサーバーは deviceWrites: true",
  "setup": {
    "initialize": false,
    "allowWrites": true
  },
  "request": {
    "id": 1,
    "method": "initialize",
    "params": {
      "protocolVersion": "0.5"
    }
  },
  "response": {
    "id": 1,
    "result": {
      "capabilities": {
        "device": true,
        "deviceWrites": true
      }
    }
  }
}
