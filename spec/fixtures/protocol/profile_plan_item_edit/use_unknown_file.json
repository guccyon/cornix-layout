{
  "description": "use・unuse・setIndex は項目をファイルで指す。そのファイルのその種類の項目がなければ -32602（field \"edit.file\"）",
  "setup": {
    "profile": "authors_config"
  },
  "request": {
    "id": 1,
    "method": "profile/planItemEdit",
    "params": {
      "profileId": "p1",
      "baseVersions": {
      },
      "edit": {
        "op": "use",
        "kind": "tapDance",
        "file": "macros/00_bracket_pair.yml"
      }
    }
  },
  "response": {
    "id": 1,
    "error": {
      "code": -32602,
      "data": {
        "field": "edit.file"
      }
    }
  }
}
