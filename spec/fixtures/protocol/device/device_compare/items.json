{
  "description": "エンコーダ・タップダンス・コンボ・マクロ（番号ごと）・設定の違い。並びは Planning::Plan#changes の順",
  "setup": {
    "profile": "test_config",
    "device": {
      "from": "profile",
      "set": [
        {
          "path": [
            "encoder_layout",
            0,
            0,
            1
          ],
          "value": "KC_NO"
        },
        {
          "path": [
            "macro",
            0
          ],
          "value": []
        },
        {
          "path": [
            "macro",
            3
          ],
          "value": [
            [
              "tap",
              "KC_A"
            ]
          ]
        },
        {
          "path": [
            "tap_dance",
            1,
            4
          ],
          "value": 180
        },
        {
          "path": [
            "combo",
            0,
            4
          ],
          "value": "KC_B"
        },
        {
          "path": [
            "settings",
            "7"
          ],
          "value": 300
        }
      ]
    }
  },
  "request": {
    "id": 1,
