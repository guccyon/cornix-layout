{
  "description": "shortcuts.yaml がなければ作ってショートカットを足す",
  "setup": {
    "profile": "authors_config"
  },
  "request": {
    "id": 1,
    "method": "profile/planItemEdit",
    "params": {
      "profileId": "p1",
      "baseVersions": {
        "shortcuts.yaml": null
      },
      "edit": {
        "op": "create",
        "kind": "shortcut",
        "name": "前のタブへ",
        "value": "Command + Shift + ["
      }
    }
  },
  "response": {
    "id": 1,
    "result": {
      "files": [
        {
          "file": "shortcuts.yaml",
          "baseVersion": null,
          "create": true,
          "edits": [
            {
              "range": {
                "start": {
                  "line": 0,
                  "character": 0
                },
                "end": {
                  "line": 0,
                  "character": 0
                }
              },
              "newText": "shortcuts:\n  前のタブへ: Command + Shift + [\n"
            }
          ]
        }
      ],
      "references": [

      ],
      "diagnostics": [

      ]
    }
  }
}
