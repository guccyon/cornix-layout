{
  "description": "まだない名前の [\"shortcuts\", 名前] の set で、名前の決まり（空でない・前後の空白なし）に合わなければ -32602（field \"changes[0].address\"）",
  "setup": {
    "profile": "authors_config"
  },
  "request": {
    "id": 1,
    "method": "profile/planEdits",
    "params": {
      "profileId": "p1",
      "baseVersions": {
        "shortcuts.yaml": null
      },
      "changes": [
        {
          "address": {
            "file": "shortcuts.yaml",
            "path": [
              "shortcuts",
              " 前のタブへ"
            ]
          },
          "value": "Command + Shift + ["
        }
      ]
    }
  },
  "response": {
    "id": 1,
    "error": {
      "code": -32602,
      "data": {
        "field": "changes[0].address"
      }
    }
  }
}
