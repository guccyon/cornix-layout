{
  "description": "tapDanceAction の exclude はその表記と同じ値の候補（タップダンス自身）を除く",
  "setup": {
    "profile": "authors_config"
  },
  "request": {
    "id": 1,
    "method": "keycode/candidates",
    "params": {
      "profileId": "p1",
      "context": "tapDanceAction",
      "query": "Tab",
      "exclude": "TapDance('Tab Escape')"
    }
  },
  "response": {
    "id": 1,
    "result": {
      "items": [
        {
          "insertText": "Tab",
          "label": "Tab",
          "detail": "KC_TAB",
          "category": "basic"
        }
      ],
      "truncated": false
    }
  }
}
