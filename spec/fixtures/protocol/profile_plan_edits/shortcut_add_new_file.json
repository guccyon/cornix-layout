{
  "description": "まだない名前の [\"shortcuts\", 名前] の set（v0.5。protocol.md の 15.2）: shortcuts.yaml がなければ create: true で作る",
  "setup": {
    "profile": "authors_config"
  },
  "request": {
    "id": 1,
    "method": "profile/planEdits",
    "params": {
      "profileId": "p1",
      "baseVersions": {
        "shortcuts.yaml": null
      },
      "changes": [
        {
          "address": {
            "file": "shortcuts.yaml",
            "path": [
              "shortcuts",
              "前のタブへ"
            ]
          },
          "value": "Command + Shift + ["
        }
      ]
    }
  },
  "response": {
    "id": 1,
    "result": {
      "files": [
        {
          "file": "shortcuts.yaml",
          "baseVersion": null,
          "create": true,
          "edits": [
            {
              "range": {
                "start": {
                  "line": 0,
                  "character": 0
                },
                "end": {
                  "line": 0,
                  "character": 0
                }
              },
              "newText": "shortcuts:\n  前のタブへ: Command + Shift + [\n"
            }
          ]
        }
      ],
      "diagnostics": [

      ]
    }
  }
}
