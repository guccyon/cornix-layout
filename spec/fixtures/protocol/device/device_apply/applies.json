{
  "description": "token が計画し直したものと同じなら、バックアップを取って書き、読み直して検証する（backup のパスは日時を含むので比べない）",
  "setup": {
    "profile": "test_config",
    "allowWrites": true,
    "device": {
      "from": "profile",
      "keys": [
        {
          "layer": 0,
          "row": 0,
          "col": 1,
          "value": "KC_A"
        },
        {
          "layer": 0,
          "row": 4,
          "col": 0,
          "value": "KC_NO"
        },
        {
          "layer": 1,
          "row": 2,
          "col": 6,
          "value": "KC_B"
        }
      ]
    }
  },
  "request": {
    "id": 1,
    "method": "device/apply",
    "params": {
      "dir": "profiles/default",
      "token": "828ecd9225e5c798"
    }
  },
  "response": {
    "id": 1,
    "result": {
      "applied": 3,
      "remaining": []
    }
  }
}
